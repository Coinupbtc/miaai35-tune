[Unit]
Description=MiaAI-Lab Qwen3.6-35B (PASS7 balanced: ctx64k fa kv-q8 parallel2 mmproj)
Documentation=https://github.com/MiaAI-Lab/Qwen3.6-35B-A3B-UD-Q8_K_XL_DGX-Spark-Recipe
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5
OnFailure=llama-miaai35-alert.service

[Service]
Type=exec
ExecStart=$HOME/llama.cpp/build/bin/llama-server \
  --model $HOME/models/dgx_bundle/qwen3.6-35b-a3b-ud/Qwen3.6-35B-A3B-UD-Q8_K_XL.gguf \
  --mmproj $HOME/models/dgx_bundle/qwen3.6-35b-a3b-ud/mmproj-BF16.gguf \
  --ctx-size 65536 \
  --parallel 2 \
  --flash-attn on \
  --cache-type-k q8_0 \
  --cache-type-v q8_0 \
  --batch-size 2048 \
  --ubatch-size 512 \
  --host 0.0.0.0 \
  --port 8889 \
  --temperature 0.6 \
  --top-p 0.95 \
  --top-k 20 \
  --min-p 0.0 \
  --presence-penalty 0.0 \
  --repeat-penalty 1.0 \
  --chat-template-kwargs '{"preserve_thinking":true}'
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
