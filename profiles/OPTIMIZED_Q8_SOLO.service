[Unit]
Description=MiaAI-Lab Qwen3.6-35B Q8 SOLO (same weights; 1 slot max single-stream t/s)
Documentation=file://$HOME/models/dgx_bundle/miaai35-tune/REPORT.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5
OnFailure=llama-miaai35-alert.service

[Service]
Type=exec
# SAME Q8 GGUF. Single slot — best interactive decode when agents are not multi-firing.
ExecStart=$HOME/llama.cpp/build/bin/llama-server \
  --model $HOME/models/dgx_bundle/qwen3.6-35b-a3b-ud/Qwen3.6-35B-A3B-UD-Q8_K_XL.gguf \
  --mmproj $HOME/models/dgx_bundle/qwen3.6-35b-a3b-ud/mmproj-BF16.gguf \
  --ctx-size 131072 \
  --parallel 1 \
  --flash-attn on \
  --cache-type-k q4_0 \
  --cache-type-v q4_0 \
  --batch-size 4096 \
  --ubatch-size 1024 \
  --prio 2 \
  --poll 100 \
  --host 0.0.0.0 \
  --port 8889 \
  --temperature 0.6 \
  --top-p 0.95 \
  --top-k 20 \
  --min-p 0.0 \
  --presence-penalty 0.0 \
  --repeat-penalty 1.0 \
  --chat-template-kwargs '{"preserve_thinking":true}'
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
