[Unit]
Description=MiaAI-Lab Qwen3.6-35B BALANCED v5 (MTP-Q8 spec n6 p075, 128k fa kv-q8 ub1024)
Documentation=file://$HOME/models/dgx_bundle/miaai35-tune/REPORT.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5
OnFailure=llama-miaai35-alert.service

[Service]
Type=exec
# ORIGINAL recipe + flash-attn + quantized KV. Keeps 131072 ctx and default
# parallel slots for multi-agent. Measured PASS3: quality 9/10,
# ~same decode t/s as ORIGINAL, ~1 GB less GPU footprint.
# Client daily: enable_thinking=false; hard tasks: enable_thinking=true.
ExecStart=$HOME/llama.cpp-master/build/bin/llama-server \
  --model $HOME/models/dgx_bundle/qwen-nvfp4-gguf/q36-35b-a3b-nvfp4.gguf \
  --mmproj $HOME/models/dgx_bundle/qwen3.6-35b-a3b-ud/mmproj-BF16.gguf \
  --ctx-size 131072 \
  --flash-attn on \
  --cache-type-k q8_0 \
  --cache-type-v q8_0 \
  --batch-size 4096 \
  --ubatch-size 1024 \
  --spec-type draft-mtp,ngram-mod,ngram-simple \
  --spec-draft-n-max 6 \
  --spec-draft-p-min 0.75 \
  --host 127.0.0.1 \
  --port 8889 \
  --temperature 0.6 \
  --top-p 0.95 \
  --top-k 20 \
  --min-p 0.0 \
  --presence-penalty 0.0 \
  --repeat-penalty 1.0 \
  --chat-template-kwargs '{"preserve_thinking":true}'
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
